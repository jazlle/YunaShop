{
  "type": "record",
  "namespace": "com.yuna.yunashop.events",
  "name": "OrderCancelledEvent",
  "doc": "Publié par order-service sur order.cancelled : la saga est abandonnée, les participants doivent compenser ce qu'ils ont fait pour cette commande (et ne rien faire s'ils n'ont rien fait).",
  "fields": [
    {"name": "orderId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "reason", "type": "string"}
  ]
}
